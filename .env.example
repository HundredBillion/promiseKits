# .env.example
# Example environment variables for promisekits.
# Copy this file to `.env` (or use your secrets manager) and fill in the real values.
# DO NOT commit your real `.env` to source control. This repository already ignores `.env*`.
#
# Quick checklist:
# - Create a local `.env` from this file: `cp .env.example .env`
# - Edit `.env` with real secrets (do not commit)
# - For Docker Compose, docker will load .env automatically when present
# - For production, use your platform's secret manager instead of .env files
#
# If you do not already have the following entry in .gitignore, add:
#   /.env
#   /.env.*


# Rails / environment
RAILS_ENV=development
PORT=3000

# Database (Postgres example)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=promisekits_development
# Optionally override DATABASE_URL instead of individual vars:
# DATABASE_URL=postgres://postgres:changeme@db:5432/promisekits_development

# Redis (used by Sidekiq)
REDIS_URL=redis://redis:6379/0

# Host used by mailer URL helpers (default_url_options)
MAILER_HOST=localhost:3000
MAILER_PROTOCOL=http

# ActionMailer / SMTP settings
#
# For Google Workspace (smtp.gmail.com) you can:
# - Create an App Password (recommended if 2FA is enabled) and use it as SMTP_PASSWORD, OR
# - Configure an SMTP relay in Google Admin and point SMTP_ADDRESS to smtp-relay.gmail.com
#
# Example values:
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=yourdomain.com
SMTP_USER=you@yourdomain.com
# If using Google App Password: set SMTP_PASSWORD to the app password (16 chars, no spaces)
SMTP_PASSWORD=changeme_app_password_or_smtp_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
# Optional: set openssl verify mode if needed (avoid 'none' in production unless absolutely necessary)
# SMTP_OPENSSL_VERIFY_MODE=none

# Mailer behavior toggles
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
ORDER_EXPORT_RECIPIENT=reports@yourdomain.com

# Toggle mail delivery (useful for CI/test)
# Set SMTP_ENABLED=false to disable real SMTP delivery (emails will be suppressed)
SMTP_ENABLED=true

# Delivery method override (smtp, test, letter_opener)
MAIL_DELIVERY_METHOD=smtp

# For local development, you can use letter_opener to open mails in browser:
USE_LETTER_OPENER=false

# Sidekiq/Worker settings
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_QUEUES=default

# Secrets (Rails credentials)
# If you use credentials, do NOT store actual keys here; keep them in encrypted credentials or use env vars.
SECRET_KEY_BASE=replace_with_secure_random_value
RAILS_MASTER_KEY=replace_with_rails_master_key_if_used

# Optional: S3 (for uploading large exports instead of attaching)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Optional: monitoring / metrics (if used)
# DATADOG_API_KEY=
# NEW_RELIC_LICENSE_KEY=

# Notes & guidance
# - Keep this file in the repo as an example only. Never commit secrets.
# - In Docker Compose, prefer to source secret values from a .env file that is not committed,
#   or better: use Compose secrets (or your orchestration secret store) in production.
# - For Google Workspace SMTP:
#   - If your account uses 2-step verification, create an App Password and use that as SMTP_PASSWORD.
#   - For server-side sending with fixed IP(s), consider configuring SMTP relay in Google Admin and authorizing your server IPs.
# - If you expect large attachments (> ~20-25MB), consider uploading the generated XLSX to S3 and emailing a pre-signed download link instead of attaching the file.
#
# Example: create a local .env
#   cp .env.example .env
#   # edit .env and set SMTP_PASSWORD and other sensitive values
#
# For Docker Compose, do not commit the populated .env. Add .env to your personal/global gitignore if needed.
