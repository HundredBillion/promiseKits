<div class="admin-coupons">
  <div class="admin-coupons-header coupons-header">
    <h1>Coupon Codes</h1>
    <div class="header-controls">
      <%= form_with url: admin_coupon_codes_path, method: :post, data: { turbo: false }, class: "bulk-create-form", local: true do %>
        <div class="bulk-create-controls">
          <%= number_field_tag :count, params[:count] || 1, min: 1, class: "bulk-count-input" %>
          <%= submit_tag "Create Coupons", class: "btn-create" %>
        </div>
      <% end %>

      <%= form_with url: admin_coupon_sequence_path, method: :patch, local: true, class: 'sequence-form' do %>
        <div class="sequence-controls">
          <span>Next sequence will start at: <strong><%= CouponSequence.default.last_sequence + 1 %></strong></span>
          <%= number_field_tag 'coupon_sequence[last_sequence]', CouponSequence.default.last_sequence, min: 0, class: 'sequence-input' %>
          <%= submit_tag 'Set Sequence', class: 'btn-set-sequence' %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="admin-coupons-filters coupons-filters">
    <div class="filter-buttons">
      <%= link_to "All", admin_coupon_codes_path, class: "filter-btn #{params[:status].blank? ? 'active' : ''}" %>
      <%= link_to "Unused", admin_coupon_codes_path(status: 'unused'), class: "filter-btn #{params[:status] == 'unused' ? 'active' : ''}" %>
      <%= link_to "Used", admin_coupon_codes_path(status: 'used'), class: "filter-btn #{params[:status] == 'used' ? 'active' : ''}" %>
    </div>

    <%= form_with url: admin_coupon_codes_path, method: :get, class: "search-form" do |f| %>
      <%= f.hidden_field :status, value: params[:status] if params[:status].present? %>
      <%= f.text_field :search, value: params[:search], placeholder: "Search by code...", class: "search-input" %>
      <%= f.submit "Search", class: "search-btn" %>
      <% if params[:search].present? %>
        <%= link_to "Clear", admin_coupon_codes_path(status: params[:status]), class: "btn-clear" %>
      <% end %>
    <% end %>
  </div>

  <div class="admin-coupons-card coupon-list">
    <table class="coupon-table" style="width:100%; border-collapse: collapse;">
      <thead>
        <tr class="admin-coupons-header header-row">
          <th style="text-align:left; padding: 0.75rem 1rem;">Code</th>
          <th style="text-align:left; padding: 0.75rem 1rem; width:120px;">Status</th>
          <th style="text-align:left; padding: 0.75rem 1rem; width:160px;">Created At</th>
          <th style="text-align:left; padding: 0.75rem 1rem; width:180px;">Associated Order</th>
          <th style="text-align:right; padding: 0.75rem 1rem; width:120px;">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if @coupons.any? %>
          <% @coupons.each do |coupon| %>
            <tr class="coupon-row" style="border-bottom: 1px solid #e5e7eb;">
              <td class="coupon-code" style="padding: 0.75rem 1rem; vertical-align: middle;">
                <%= coupon.code %>
              </td>

              <td style="padding: 0.75rem 1rem; vertical-align: middle;">
                <% if coupon.unused? %>
                  <span class="coupon-status unused">Unused</span>
                <% else %>
                  <span class="coupon-status used">Used</span>
                <% end %>
              </td>

              <td class="coupon-created" style="padding: 0.75rem 1rem; vertical-align: middle;">
                <%= coupon.created_at.strftime("%Y-%m-%d %H:%M") %>
              </td>

              <td class="coupon-order" style="padding: 0.75rem 1rem; vertical-align: middle;">
                <% if coupon.orders.any? %>
                  <%= link_to "Order ##{coupon.orders.first.id}", order_path(coupon.orders.first) %>
                <% else %>
                  <span class="coupon-empty">—</span>
                <% end %>
              </td>

              <td class="coupon-action" style="padding: 0.75rem 1rem; vertical-align: middle; text-align: right;">
                <% if coupon.unused? && coupon.orders.empty? %>
                  <%= button_to "Delete", admin_coupon_code_path(coupon), method: :delete, class: "btn-delete", form: { data: { turbo_confirm: "Are you sure you want to delete this coupon code?" } } %>
                <% else %>
                  <span class="coupon-empty">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr class="coupon-row">
            <td class="coupon-empty" colspan="5" style="padding: 0.75rem 1rem; text-align: left;">No coupon codes found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="admin-coupons-footer">
    <div class="pagination">
      <div class="pagination-group">
        <% if params[:cursor].present? %>
          <%= link_to "← Previous", admin_coupon_codes_path(cursor: @coupons.first.id, direction: 'prev', status: params[:status], search: params[:search]), class: "pagination-btn" %>
        <% else %>
          <span class="pagination-btn disabled">← Previous</span>
        <% end %>

        <% if @has_more %>
          <%= link_to "Next →", admin_coupon_codes_path(cursor: @coupons.last.id, direction: 'next', status: params[:status], search: params[:search]), class: "pagination-btn" %>
        <% else %>
          <span class="pagination-btn disabled">Next →</span>
        <% end %>
      </div>

      <div class="text-sm text-gray-600">
        Showing <%= @coupons.size %> coupon<%= @coupons.size == 1 ? '' : 's' %>
      </div>
    </div>
  </div>
</div>
